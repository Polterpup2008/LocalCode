# Normalise to LF in the repository; check out with the platform's convention.
* text=auto

*.cpp   text diff=cpp
*.h     text diff=cpp
*.cmake text
*.md    text diff=markdown
*.json  text
*.yml   text
*.py    text diff=python

# Scripts that must keep their platform's endings to run.
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.sh    text eol=lf

# Never touched.
*.png   binary
*.gguf  binary

