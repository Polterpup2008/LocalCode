index 0000000..fcf6897
--- /dev/null
+++ b/src/llama-mmap-intervals.h
@@ -0,0 +1,34 @@
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <utility>
+#include <vector>
+
+namespace llama_mmap_intervals {
+using ranges = std::vector<std::pair<size_t, size_t>>;
+struct host_span { size_t file; size_t first; size_t last; };
+
+// Called only after weights finish loading. Keep lazy rows and complete no-copy spans.
+template<class LazyByFile>
+std::vector<ranges> collect(size_t files, const LazyByFile & lazy, const std::vector<host_span> & host) {
+    std::vector<ranges> retained(files);
+    for (const auto & entry : lazy) retained.at(entry.first) = entry.second;
+    for (const auto & span : host) retained.at(span.file).emplace_back(span.first, span.last);
+    return retained;
+}
+
+// Emit only gaps in a clamped union. The caller rounds gaps inward to full pages.
+template<class Emit>
+void for_unused(size_t size, std::vector<std::pair<size_t, size_t>> retained, Emit emit) {
+    std::sort(retained.begin(), retained.end());
+    size_t cursor = 0;
+    for (const auto & range : retained) {
+        if (range.first >= range.second || range.first >= size) continue;
+        const size_t first = range.first;
+        const size_t last = std::min(range.second, size);
+        if (first > cursor) emit(cursor, first);
+        cursor = std::max(cursor, last);
+    }
+    if (cursor < size) emit(cursor, size);
+}
+} // namespace llama_mmap_intervals
