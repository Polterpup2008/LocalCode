diff --git a/ggml/src/ggml-vulkan/localcode-pipeline-cache.h b/ggml/src/ggml-vulkan/localcode-pipeline-cache.h
new file mode 100644
index 0000000..99a332f
--- /dev/null
+++ b/ggml/src/ggml-vulkan/localcode-pipeline-cache.h
@@ -0,0 +1,100 @@
+// LocalCode additions: see LICENSE-LOCALCODE-MODIFICATIONS.txt in the runtime package.
+// Original llama.cpp and Vulkan portions retain their respective licenses.
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <vector>
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+namespace localcode_vk_cache {
+using bytes = std::vector<uint8_t>;
+struct key {
+    uint32_t vendor, device, driver, pointer_size;
+    std::array<uint8_t, 16> uuid;
+};
+constexpr size_t max_bytes = 64 * 1024 * 1024;
+constexpr size_t header_bytes = 56;
+inline void put(bytes & out, uint64_t v, size_t count) {
+    for (size_t i = 0; i < count; ++i) out.push_back(uint8_t(v >> (8 * i)));
+}
+inline uint64_t get(const bytes & data, size_t at, size_t count) {
+    uint64_t value = 0;
+    for (size_t i = 0; i < count; ++i) value |= uint64_t(data[at + i]) << (8 * i);
+    return value;
+}
+// Detect accidental truncation/corruption before handing opaque data to a
+// driver. This is not an authentication mechanism for adversarial cache files.
+inline uint64_t checksum(const uint8_t * data, size_t size) {
+    uint64_t value = 14695981039346656037ull;
+    for (size_t i = 0; i < size; ++i) value = (value ^ data[i]) * 1099511628211ull;
+    return value;
+}
+inline bool valid_vulkan_header(const bytes & data, const key & k) {
+    return data.size() >= 32 && get(data, 0, 4) >= 32 && get(data, 0, 4) <= data.size() &&
+           get(data, 4, 4) == 1 && get(data, 8, 4) == k.vendor && get(data, 12, 4) == k.device &&
+           std::memcmp(data.data() + 16, k.uuid.data(), 16) == 0;
+}
+inline bytes encode(const bytes & payload, const key & k) {
+    if (payload.size() > max_bytes || !valid_vulkan_header(payload, k)) return {};
+    bytes out = {'L', 'C', 'V', 'K', '0', '0', '0', '1'};
+    put(out, k.vendor, 4); put(out, k.device, 4); put(out, k.driver, 4); put(out, k.pointer_size, 4);
+    out.insert(out.end(), k.uuid.begin(), k.uuid.end());
+    put(out, payload.size(), 8); put(out, checksum(payload.data(), payload.size()), 8);
+    out.insert(out.end(), payload.begin(), payload.end());
+    return out;
+}
+inline bytes decode(const bytes & data, const key & k) {
+    if (data.size() < header_bytes || data.size() > header_bytes + max_bytes ||
+        std::memcmp(data.data(), "LCVK0001", 8) || get(data, 8, 4) != k.vendor ||
+        get(data, 12, 4) != k.device || get(data, 16, 4) != k.driver ||
+        get(data, 20, 4) != k.pointer_size || std::memcmp(data.data() + 24, k.uuid.data(), 16) ||
+        get(data, 40, 8) != data.size() - header_bytes ||
+        get(data, 48, 8) != checksum(data.data() + header_bytes, data.size() - header_bytes)) return {};
+    bytes payload(data.begin() + header_bytes, data.end());
+    return valid_vulkan_header(payload, k) ? payload : bytes{};
+}
+inline bytes load(const std::filesystem::path & path, const key & k) {
+    std::ifstream input(path, std::ios::binary | std::ios::ate);
+    if (!input) return {};
+    const auto size = input.tellg();
+    if (size < std::streampos(header_bytes) || size > std::streampos(header_bytes + max_bytes)) return {};
+    bytes data(static_cast<size_t>(size));
+    input.seekg(0);
+    if (!input.read(reinterpret_cast<char *>(data.data()), std::streamsize(data.size()))) return {};
+    return decode(data, k);
+}
+inline bool save(const std::filesystem::path & path, const bytes & payload, const key & k,
+                 const std::string & suffix) {
+    const auto data = encode(payload, k);
+    if (data.empty()) return false;
+    std::error_code ec;
+    std::filesystem::create_directories(path.parent_path(), ec);
+    if (ec) return false;
+    auto temp = path;
+    temp += ".tmp-" + suffix;
+    {
+        std::ofstream output(temp, std::ios::binary | std::ios::trunc);
+        if (!output || !output.write(reinterpret_cast<const char *>(data.data()), std::streamsize(data.size()))) {
+            output.close(); std::filesystem::remove(temp, ec); return false;
+        }
+        output.flush();
+        if (!output) { output.close(); std::filesystem::remove(temp, ec); return false; }
+        output.close();
+        if (output.fail()) { std::filesystem::remove(temp, ec); return false; }
+    }
+#ifdef _WIN32
+    if (!MoveFileExW(temp.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) {
+        std::filesystem::remove(temp, ec); return false;
+    }
+#else
+    std::filesystem::rename(temp, path, ec);
+    if (ec) { std::filesystem::remove(temp, ec); return false; }
+#endif
+    return true;
+}
+} // namespace localcode_vk_cache
