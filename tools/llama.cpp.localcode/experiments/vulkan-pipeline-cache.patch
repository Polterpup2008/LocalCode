+}
+
+static void localcode_init_pipeline_cache(vk_device_struct & device) {
+    try {
+#ifdef _WIN32
+        const auto * directory = _wgetenv(L"GGML_VK_PIPELINE_CACHE_DIR");
+#else
+        const auto * directory = std::getenv("GGML_VK_PIPELINE_CACHE_DIR");
+#endif
+        if (!directory || !*directory) return; // Opt-in until measured and qualified.
+        const auto key = localcode_cache_key(device);
+        std::ostringstream name;
+        name << "llama-b11829-v1-" << std::hex << key.vendor << '-' << key.device << '-'
+             << key.driver << '-' << key.pointer_size << '-';
+        for (const auto b : key.uuid) name << std::setw(2) << std::setfill('0') << unsigned(b);
+        device.localcode_pipeline_cache_path = std::filesystem::path(directory) / (name.str() + ".bin");
+        const auto data = localcode_vk_cache::load(device.localcode_pipeline_cache_path, key);
+        try {
+            // Zero flags preserve the driver's internal synchronization for
+            // parallel pipeline compilation. Do not request EXTERNALLY_SYNCHRONIZED.
+            device.localcode_pipeline_cache = device.device.createPipelineCache(
+                vk::PipelineCacheCreateInfo({}, data.size(), data.empty() ? nullptr : data.data()));
+            if (!data.empty()) device.localcode_pipeline_cache_checksum.store(localcode_vk_cache::checksum(data.data(), data.size()));
+            GGML_LOG_INFO("ggml_vulkan: LocalCode pipeline cache initialized (%zu stored bytes)\n", data.size());
+        } catch (const std::exception &) {
+            // A cache miss, bad driver blob or unavailable cache must not
+            // prevent an otherwise supported GPU from running.
+            device.localcode_pipeline_cache = device.device.createPipelineCache({});
+            GGML_LOG_WARN("ggml_vulkan: LocalCode pipeline cache reset after driver rejection\n");
+        }
+    } catch (const std::exception &) {
+        GGML_LOG_WARN("ggml_vulkan: optional LocalCode pipeline cache unavailable\n");
+    }
+}
+
+static void localcode_save_pipeline_cache(vk_device_struct & device) {
