+                    GGML_LOG_INFO("ggml_vulkan: LocalCode pipeline cache saved (%zu bytes)\n", size);
+                }
+            }
+        }
+    } catch (const std::exception &) {
+        GGML_LOG_WARN("ggml_vulkan: optional LocalCode pipeline cache was not saved\n");
+    }
+}

