--- /dev/null
+++ b/ggml/src/ggml-cpu/arch/x86/os-xstate.h
@@ -0,0 +1,12 @@
+#pragma once
+#include <cstdint>
+
+namespace ggml_xstate {
+constexpr uint64_t avx = 0x6;
+constexpr uint64_t avx512 = 0xe6;
+constexpr uint64_t tiles = uint64_t(3) << 17;
+
+constexpr bool usable(bool xsave, bool osxsave, uint64_t enabled, uint64_t required) {
+    return required == 0 || (xsave && osxsave && (enabled & required) == required);
+}
+}
