+++ b/common/shared_checkpoint_bytes.h
@@ -0,0 +1,31 @@
+#pragma once
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+class common_checkpoint_bytes {
+    std::shared_ptr<std::vector<uint8_t>> bytes_;
+public:
+    size_t size() const { return bytes_ ? bytes_->size() : 0; }
+    bool empty() const { return size() == 0; }
+    const uint8_t* data() const { return bytes_ ? bytes_->data() : nullptr; }
+    size_t capacity() const { return bytes_ ? bytes_->capacity() : 0; }
+    void clear() {
+        if (bytes_ && bytes_.use_count() == 1) bytes_->clear();
+        else bytes_.reset();
+    }
+    uint8_t* overwrite(size_t size) {
+        if (!bytes_ || bytes_.use_count() != 1) bytes_ = std::make_shared<std::vector<uint8_t>>(size);
+        else bytes_->resize(size);
+        return bytes_->data();
+    }
+    const std::vector<uint8_t>& vector() const {
+        static const std::vector<uint8_t> empty;
+        return bytes_ ? *bytes_ : empty;
+    }
+    std::vector<uint8_t>& mutable_vector() {
+        if (!bytes_) bytes_ = std::make_shared<std::vector<uint8_t>>();
+        else if (bytes_.use_count() != 1) bytes_ = std::make_shared<std::vector<uint8_t>>(*bytes_);
+        return *bytes_;
+    }
+};
