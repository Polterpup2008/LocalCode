# User data and model weights never enter this tree.
include(GNUInstallDirs)
if(MSVC)
    set(CMAKE_INSTALL_SYSTEM_RUNTIME_DESTINATION bin)
    include(InstallRequiredSystemLibraries)
endif()
install(FILES "${CMAKE_SOURCE_DIR}/LICENSE" "${CMAKE_SOURCE_DIR}/docs/THIRD_PARTY_NOTICES.md"
    DESTINATION share/localcode)
install(FILES "${CMAKE_SOURCE_DIR}/docs/RAM_RUNTIME.md" DESTINATION share/localcode)
install(FILES "${CMAKE_SOURCE_DIR}/docs/GETTING_STARTED.md"
              "${CMAKE_SOURCE_DIR}/docs/RELEASE_NOTES_1.1.md"
              "${CMAKE_SOURCE_DIR}/docs/KNOWN_LIMITATIONS_1.1.md"
              "${CMAKE_SOURCE_DIR}/docs/KNOWN_LIMITATIONS_1.0.md"
        DESTINATION share/localcode)
install(DIRECTORY "${CMAKE_SOURCE_DIR}/packaging/licenses/" DESTINATION share/localcode/licenses)
set(LOCALCODE_LLAMA_RUNTIME_PACKAGE "" CACHE PATH "Verified bundled Windows llama.cpp runtime")
set(LOCALCODE_VULKAN_RUNTIME_PACKAGE "" CACHE PATH "Verified bundled Windows Vulkan alternative")
foreach(runtime_variant primary vulkan)
if(runtime_variant STREQUAL "primary")
    set(runtime_package "${LOCALCODE_LLAMA_RUNTIME_PACKAGE}")
    set(runtime_destination "bin/llama.cpp.localcode")
    set(runtime_target localcode_runtime)
else()
    set(runtime_package "${LOCALCODE_VULKAN_RUNTIME_PACKAGE}")
    set(runtime_destination "bin/llama.cpp.localcode/vulkan")
    set(runtime_target localcode_runtime_vulkan)
endif()
if(WIN32 AND runtime_package)
    file(READ "${runtime_package}/manifest.json" runtime_manifest LIMIT 65537)
    string(JSON runtime_format GET "${runtime_manifest}" format)
    string(JSON runtime_id GET "${runtime_manifest}" id)
    string(JSON runtime_arch GET "${runtime_manifest}" architecture)
    if(NOT runtime_format EQUAL 1 OR NOT runtime_id STREQUAL "localcode.runtime" OR
       NOT runtime_arch STREQUAL "windows-x64")
        message(FATAL_ERROR "Invalid bundled runtime manifest")
    endif()
    string(JSON runtime_count LENGTH "${runtime_manifest}" files)
    if(runtime_count LESS 3 OR runtime_count GREATER 96)
        message(FATAL_ERROR "Invalid bundled runtime file count")
    endif()
    set(runtime_files "${runtime_package}/manifest.json")
    set(runtime_names)
    math(EXPR runtime_last "${runtime_count} - 1")
    foreach(index RANGE 0 ${runtime_last})
        string(JSON name GET "${runtime_manifest}" files ${index} name)
        string(JSON expected GET "${runtime_manifest}" files ${index} sha256)
        if(NOT name MATCHES "^[A-Za-z0-9][A-Za-z0-9_.-]*$" OR
           (name MATCHES "[.]exe$" AND NOT name STREQUAL "llama-server.exe"))
            message(FATAL_ERROR "Invalid bundled runtime file name")
        endif()
        file(SHA256 "${runtime_package}/${name}" actual)
        string(TOLOWER "${expected}" expected)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Bundled runtime digest mismatch: ${name}")
        endif()
        list(APPEND runtime_names "${name}")
        list(APPEND runtime_files "${runtime_package}/${name}")
    endforeach()
    foreach(required llama-server.exe llama-server-impl.dll llama-common.dll llama.dll ggml.dll ggml-base.dll LICENSE)
        if(NOT required IN_LIST runtime_names)
            message(FATAL_ERROR "Bundled runtime is missing ${required}")
        endif()
    endforeach()
    if(runtime_variant STREQUAL "vulkan" AND NOT "ggml-vulkan.dll" IN_LIST runtime_names)
        message(FATAL_ERROR "The Vulkan alternative is missing its GPU backend")
    endif()
    install(FILES ${runtime_files} DESTINATION "${runtime_destination}")
    add_custom_target(${runtime_target}
        COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_BINARY_DIR}/${runtime_destination}"
        COMMAND ${CMAKE_COMMAND} -E copy_if_different ${runtime_files}
                "${CMAKE_BINARY_DIR}/${runtime_destination}"
        COMMAND_EXPAND_LISTS VERBATIM)
    foreach(target localcode localcode-doctor localcode_tests localcode_gui_tests)
        if(TARGET ${target})
            add_dependencies(${target} ${runtime_target})
        endif()
    endforeach()
endif()
endforeach()
set(LOCALCODE_DISCORD_PACKAGE "" CACHE PATH "Optional public Discord process-plugin package")
if(LOCALCODE_DISCORD_PACKAGE)
    foreach(required manifest.json lcd.exe LICENSE README.md)
        if(NOT EXISTS "${LOCALCODE_DISCORD_PACKAGE}/${required}")
            message(FATAL_ERROR "Incomplete Discord plugin package: ${required}")
        endif()
    endforeach()
    install(FILES
        "${LOCALCODE_DISCORD_PACKAGE}/manifest.json" "${LOCALCODE_DISCORD_PACKAGE}/lcd.exe"
        "${LOCALCODE_DISCORD_PACKAGE}/LICENSE" "${LOCALCODE_DISCORD_PACKAGE}/README.md"
        DESTINATION plugins/discord)
    install(FILES "${LOCALCODE_DISCORD_PACKAGE}/THIRD_PARTY_NOTICES.txt" DESTINATION plugins/discord)
    install(FILES "${LOCALCODE_DISCORD_PACKAGE}/vcruntime140.dll" DESTINATION plugins/discord OPTIONAL)
    install(FILES "${LOCALCODE_DISCORD_PACKAGE}/benchmark-prompt-cache.ps1"
        DESTINATION plugins/discord OPTIONAL)
    install(DIRECTORY "${LOCALCODE_DISCORD_PACKAGE}/licenses/" DESTINATION plugins/discord/licenses)
endif()
set(LOCALCODE_MEMORY_RUNTIME_PACKAGE "" CACHE PATH "Optional verified Windows RAM runtime package")
if(WIN32 AND LOCALCODE_MEMORY_RUNTIME_PACKAGE)
    set(memory_files manifest.json LICENSE README.md windows-mmap-working-set.patch)
    foreach(name IN LISTS memory_files)
        if(NOT EXISTS "${LOCALCODE_MEMORY_RUNTIME_PACKAGE}/${name}")
            message(FATAL_ERROR "Incomplete RAM runtime package: ${name}")
        endif()
    endforeach()
    file(READ "${LOCALCODE_MEMORY_RUNTIME_PACKAGE}/manifest.json" memory_manifest LIMIT 65537)
    string(JSON memory_format GET "${memory_manifest}" format)
    string(JSON memory_id GET "${memory_manifest}" id)
    string(JSON memory_arch GET "${memory_manifest}" architecture)
    if(NOT memory_format EQUAL 1 OR NOT memory_id STREQUAL "localcode.runtime-memory" OR
       NOT memory_arch STREQUAL "windows-x64")
        message(FATAL_ERROR "Invalid RAM runtime package manifest")
    endif()
    string(JSON memory_count LENGTH "${memory_manifest}" files)
    if(memory_count LESS 1 OR memory_count GREATER 32)
        message(FATAL_ERROR "Invalid RAM runtime file count")
    endif()
    math(EXPR memory_last "${memory_count} - 1")
    foreach(index RANGE 0 ${memory_last})
        string(JSON name GET "${memory_manifest}" files ${index} name)
        string(JSON expected GET "${memory_manifest}" files ${index} sha256)
        if(NOT name MATCHES "^[A-Za-z0-9][A-Za-z0-9_.-]*[.]dll$")
            message(FATAL_ERROR "Invalid RAM runtime file name")
        endif()
        file(SHA256 "${LOCALCODE_MEMORY_RUNTIME_PACKAGE}/${name}" actual)
        string(TOLOWER "${expected}" expected)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "RAM runtime package digest mismatch: ${name}")
        endif()
        list(APPEND memory_files "${name}")
    endforeach()
    list(TRANSFORM memory_files PREPEND "${LOCALCODE_MEMORY_RUNTIME_PACKAGE}/")
    install(FILES ${memory_files} DESTINATION bin/runtime-memory)
    add_custom_target(localcode_memory_runtime
        COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/runtime-memory"
        COMMAND ${CMAKE_COMMAND} -E copy_if_different ${memory_files}
                "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/runtime-memory"
        COMMAND_EXPAND_LISTS VERBATIM)
    foreach(target localcode localcode_gui_tests)
        if(TARGET ${target})
            add_dependencies(${target} localcode_memory_runtime)
        endif()
    endforeach()
endif()
set(LOCALCODE_REASONING_RUNTIME_PACKAGE "" CACHE PATH "Optional verified Windows CPU reasoning repair")
if(WIN32 AND LOCALCODE_REASONING_RUNTIME_PACKAGE)
    set(reasoning_files manifest.json LICENSE README.md reasoning-prefill.patch OPENSSL-LICENSE.txt)
    foreach(name IN LISTS reasoning_files)
        if(NOT EXISTS "${LOCALCODE_REASONING_RUNTIME_PACKAGE}/${name}")
            message(FATAL_ERROR "Incomplete reasoning runtime package: ${name}")
        endif()
    endforeach()
    file(READ "${LOCALCODE_REASONING_RUNTIME_PACKAGE}/manifest.json" reasoning_manifest LIMIT 65537)
    string(JSON reasoning_format GET "${reasoning_manifest}" format)
    string(JSON reasoning_id GET "${reasoning_manifest}" id)
    string(JSON reasoning_arch GET "${reasoning_manifest}" architecture)
    if(NOT reasoning_format EQUAL 1 OR NOT reasoning_id STREQUAL "localcode.runtime-reasoning" OR
       NOT reasoning_arch STREQUAL "windows-x64")
        message(FATAL_ERROR "Invalid reasoning runtime manifest")
    endif()
    string(JSON reasoning_count LENGTH "${reasoning_manifest}" files)
    if(reasoning_count LESS 1 OR reasoning_count GREATER 32)
        message(FATAL_ERROR "Invalid reasoning runtime file count")
    endif()
    math(EXPR reasoning_last "${reasoning_count} - 1")
    foreach(index RANGE 0 ${reasoning_last})
        string(JSON name GET "${reasoning_manifest}" files ${index} name)
        string(JSON expected GET "${reasoning_manifest}" files ${index} sha256)
        if(NOT name MATCHES "^[A-Za-z0-9][A-Za-z0-9_.-]*[.]dll$")
            message(FATAL_ERROR "Invalid reasoning runtime file name")
        endif()
        file(SHA256 "${LOCALCODE_REASONING_RUNTIME_PACKAGE}/${name}" actual)
        string(TOLOWER "${expected}" expected)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Reasoning runtime digest mismatch: ${name}")
        endif()
        list(APPEND reasoning_files "${name}")
    endforeach()
    list(TRANSFORM reasoning_files PREPEND "${LOCALCODE_REASONING_RUNTIME_PACKAGE}/")
    install(FILES ${reasoning_files} DESTINATION bin/runtime-reasoning)
    add_custom_target(localcode_reasoning_runtime
        COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/runtime-reasoning"
        COMMAND ${CMAKE_COMMAND} -E copy_if_different ${reasoning_files}
                "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/runtime-reasoning"
        COMMAND_EXPAND_LISTS VERBATIM)
    foreach(target localcode localcode_gui_tests)
        if(TARGET ${target})
            add_dependencies(${target} localcode_reasoning_runtime)
        endif()
    endforeach()
endif()
set(CPACK_GENERATOR ZIP)
set(CPACK_PACKAGE_NAME LocalCode)
set(CPACK_PACKAGE_VENDOR LocalCode)
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
if(WIN32 AND CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(CPACK_PACKAGE_FILE_NAME "LocalCode-${PROJECT_VERSION}-Windows-x64")
else()
    set(CPACK_PACKAGE_FILE_NAME "LocalCode-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
endif()
set(CPACK_PACKAGE_DIRECTORY "${CMAKE_BINARY_DIR}/packages")
set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_SOURCE_DIR}/LICENSE")
# The packaging script passes this CMake-owned version to NSIS as well.
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/LocalCodePackageVersion.txt"
     CONTENT "${PROJECT_VERSION}\n")
include(CPack)
